# URL de l'API, utilise le network partagé défini dans les docker-compose (obligatoire)
API_URL="http://amzer-api:8000/api/v1"
# Clé secrète de signature du cookie de session (obligatoire en production :
# sans elle, les sessions sont perdues à chaque redémarrage). Ex. : python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY="""
# Affiche la console Dash. TOUJOURS false en production (exécution de code à distance).
DASH_DEBUG="false"

# --- Optionnel ---
# PORT=8050
# Durée d'inactivité avant expiration d'une session, en secondes (défaut 28800 = 8 h)
# SESSION_IDLE_TTL=28800
# Délai de rechargement des projets/tâches, en secondes (défaut 300)
# STATIC_DATA_TTL=300
